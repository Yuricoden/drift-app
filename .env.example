# DRIFT — local environment. Copy this file to .env.local and fill in the values.
# .env.local is git-ignored and is read ONLY by the Node server — never by the browser.

# The single predefined login for this MVP.
DRIFT_LOGIN_EMAIL=
DRIFT_LOGIN_PASSWORD=change-this-password

# Secret used to derive session tokens. Any long random string.
SESSION_SECRET=replace-with-a-long-random-string

# MongoDB connection (Atlas recommended, e.g. mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority).
# If omitted, the server boots with a temporary in-memory store (data is lost on restart) so the UI can be explored.
MONGODB_URI=
MONGODB_DB=drift

# OpenRouter — the single API gateway for research and AI features.
OPENROUTER_API_KEY=
# YouTube search and US Google Trends. Never use a VITE_ prefix.
SERPAPI_API_KEY=
# Model IDs are configurable server-side; these are the defaults.
OPENROUTER_SIGNAL_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_ASK_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_SONAR_MODEL=perplexity/sonar
# Trend Research persists locally when MongoDB is not configured.
DRIFT_RESEARCH_DATA_DIR=.drift/research
DRIFT_RESEARCH_MONTHLY_BUDGET=15
